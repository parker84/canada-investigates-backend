DATABASE_URL=sqlite:///./investigations.db
CORS_ORIGINS=http://localhost:5173,https://canadainvestigates.dev
SEED_CASES=true
ENABLE_SUBMISSIONS=false
APP_ENV=development
WEB_ORIGIN=http://localhost:5173
# Local-only sign-in links. Never enable on a public deployment.
AUTH_DEV_MODE=true
# Production: set APP_ENV=production and configure SMTP instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Verified addresses listed here receive editor access on account creation.
EDITOR_EMAILS=
